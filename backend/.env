# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ausfinancetools
DB_USER=postgres
DB_PASSWORD=your_password_here

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration (React app URL)
FRONTEND_URL=http://localhost:5173

# External API Keys (Optional - Free APIs)
# OpenRouteService API Key (free tier available)
# Get from: https://openrouteservice.org/
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key_here

# Transport for NSW API Key (free for basic usage)
# Get from: https://opendata.transport.nsw.gov.au/
TRANSPORT_NSW_API_KEY=your_transport_nsw_api_key_here
